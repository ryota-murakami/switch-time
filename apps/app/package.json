{
  "name": "@switch-time/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 4101",
    "web": "expo start --web --port 4101",
    "build": "pnpm build:web",
    "build:web": "expo export -p web --clear",
    "typecheck": "tsc -p tsconfig.json",
    "audit:web": "node scripts/audit-web-export.mts",
    "zones:generate": "node scripts/generate-time-zones.mts && prettier --write src/lib/time-zone-catalog.ts",
    "test": "vitest run",
    "test:e2e": "expo export -p web --clear && playwright test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "@laststance/redux-storage-middleware": "0.5.1",
    "@orpc/client": "1.16.4",
    "@orpc/tanstack-query": "1.16.4",
    "@reduxjs/toolkit": "2.15.0",
    "@switch-time/shared": "workspace:*",
    "@tanstack/react-query": "5.108.2",
    "better-auth": "1.7.27",
    "clsx": "2.1.1",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-system-ui": "^58.0.7",
    "expo-web-browser": "58.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "0.21.4",
    "react-redux": "9.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "uniwind": "1.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@switch-time/api": "workspace:*",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "mailparser": "3.15.0",
    "smtp-server": "3.21.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.1.1",
    "whatwg-fetch": "3.6.20"
  }
}
